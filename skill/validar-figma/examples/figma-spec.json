{
  "name": "Card de campanhas (exemplo)",
  "figma": { "url": "https://www.figma.com/design/EXEMPLO/Arquivo?node-id=1-2", "fileKey": "EXEMPLO", "nodeId": "1:2" },
  "viewport": { "width": 1440, "height": 900 },
  "root": "[data-testid=card]",
  "regions": [
    {
      "name": "Card",
      "selector": "[data-testid=card]",
      "figmaNode": "1:2",
      "expect": { "width": 320, "padding": [16, 24], "gap": 12, "backgroundColor": "#FFFFFF", "borderRadius": 8, "boxShadow": "0 2px 4px rgba(0,0,0,0.16)" }
    },
    {
      "name": "Título",
      "selector": "[data-testid=card] h2",
      "figmaNode": "1:3",
      "expect": { "text": "Campanhas ativas", "fontSize": 16, "lineHeight": 24, "fontWeight": "Bold", "color": "#141414" }
    },
    {
      "name": "Botão",
      "selector": "[data-testid=card] button",
      "figmaNode": "1:4",
      "expect": { "text": "Ver todas", "height": 40, "borderRadius": 20, "backgroundColor": "#0057FF", "color": "#FFFFFF", "fontWeight": "SemiBold" }
    },
    {
      "name": "Botão hover",
      "selector": "[data-testid=card] button",
      "state": "hover",
      "expect": { "backgroundColor": "#0046CC" }
    }
  ]
}
